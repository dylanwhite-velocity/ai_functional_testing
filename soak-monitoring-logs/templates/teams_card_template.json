{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.4",
        "body": [
          {
            "type": "TextBlock",
            "text": "Velocity Soak Monitoring Report",
            "size": "large",
            "weight": "bolder",
            "style": "heading"
          },
          {
            "type": "TextBlock",
            "text": "{{date}}",
            "isSubtle": true,
            "spacing": "none"
          },
          {
            "type": "TextBlock",
            "text": "**Environment Health**",
            "size": "medium",
            "weight": "bolder",
            "separator": true,
            "spacing": "medium"
          },
          {
            "type": "Container",
            "id": "env_ratings",
            "items": []
          },
          {
            "type": "TextBlock",
            "text": "**Executive Summary**",
            "size": "medium",
            "weight": "bolder",
            "separator": true,
            "spacing": "medium"
          },
          {
            "type": "TextBlock",
            "text": "{{executive_summary}}",
            "wrap": true
          },
          {
            "type": "TextBlock",
            "text": "_Report generated by soak-monitoring-logs | Model: {{model_name}}_",
            "isSubtle": true,
            "size": "small",
            "separator": true,
            "spacing": "medium"
          }
        ],
        "actions": [
          {
            "type": "Action.OpenUrl",
            "title": "View Full Report",
            "url": "{{workflow_url}}",
            "style": "positive"
          }
        ]
      }
    }
  ]
}
